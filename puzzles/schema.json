{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Constelly puzzle list",
  "description": "Draft-07 on purpose: works with jsonschema 3.x and 4.x. Coordinates: x in 0–1, y in 0–4/3 (portrait 3:4 board, one unit = board width); tools/validate_puzzles.py enforces the exact bounds and edge margin.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "title", "category", "dots", "edges"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "description": "Unique id, e.g. publish date 2026-10-01" },
      "title": { "type": "string", "description": "Revealed after solving" },
      "category": { "enum": ["animal", "plant", "object"] },
      "clue": { "type": "string", "minLength": 1, "maxLength": 80, "description": "Shown while solving: hints at the picture without naming it" },
      "dots": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "object",
          "required": ["id", "x", "y", "degree"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "x": { "type": "number", "minimum": 0, "maximum": 1 },
            "y": { "type": "number", "minimum": 0, "maximum": 1.3334 },
            "degree": { "type": "integer", "minimum": 1 }
          }
        }
      },
      "edges": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "array",
          "items": [{ "type": "string" }, { "type": "string" }],
          "additionalItems": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    }
  }
}
